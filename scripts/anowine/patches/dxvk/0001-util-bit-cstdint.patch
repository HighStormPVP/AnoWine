GCC 13's libstdc++ no longer includes <cstdint> through other headers, so
DXVK 1.10.3 does not build with it ("uint32_t was not declared"). Gcenx's
DXVK-macOS branch carries the same one-line fix.
--- a/src/util/util_bit.h
+++ b/src/util/util_bit.h
@@ -16,6 +16,7 @@
 #include "util_likely.h"
 #include "util_math.h"

+#include <cstdint>
 #include <cstring>
 #include <iterator>
 #include <type_traits>
