@@ -839,6 +839,65 @@ void init_environment(void)
 }
 
 
+/* Ano (patches/rename/0005): Apple's D3DMetal, a closed part Ano cannot
+ * rebuild, reads WINED3DMETAL and WINEESYNC itself. Ano sets ANOD3DMETAL and
+ * ANOESYNC; each process copies them to the old names in its own environment
+ * only, after its Windows environment is built (ano_env_set_aliases), and
+ * hands the old names to no other program: a forked child drops them before
+ * it execs (ano_env_unset_aliases) and every environment passed on skips them
+ * (ano_env_is_alias, ano_env_without_aliases). A child sets them again from
+ * the Ano names. scripts/anowine/aliases.txt lists them. */
+static const char * const ano_env_aliases[][2] =
+{
+    { "ANOD3DMETAL", "WINED3DMETAL" },
+    { "ANOESYNC", "WINEESYNC" },
+};
+
+void ano_env_set_aliases(void)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(ano_env_aliases); i++)
+    {
+        const char *value = getenv( ano_env_aliases[i][0] );
+        if (value) setenv( ano_env_aliases[i][1], value, 1 );
+    }
+}
+
+void ano_env_unset_aliases(void)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(ano_env_aliases); i++) unsetenv( ano_env_aliases[i][1] );
+}
+
+BOOL ano_env_is_alias( const char *entry )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(ano_env_aliases); i++)
+    {
+        size_t len = strlen( ano_env_aliases[i][1] );
+        if (!strncmp( entry, ano_env_aliases[i][1], len ) && entry[len] == '=') return TRUE;
+    }
+    return FALSE;
+}
+
+/* environ without the old names: an array the caller frees (not its strings),
+ * or environ itself if there is no memory for one. */
+char **ano_env_without_aliases(void)
+{
+    char **entry, **copy;
+    size_t count = 0;
+
+    for (entry = environ; *entry; entry++) count++;
+    if (!(copy = malloc( (count + 1) * sizeof(*copy) ))) return environ;
+    count = 0;
+    for (entry = environ; *entry; entry++) if (!ano_env_is_alias( *entry )) copy[count++] = *entry;
+    copy[count] = NULL;
+    return copy;
+}
+
