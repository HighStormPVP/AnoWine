+/* Ano (patches/rename/0007): "__ano__x" is a closed part's old name for
+ * "__ano_x", rewritten in its own memory by ano_rewrite_old_names. */
+static int find_name_in_exports( HMODULE module, const IMAGE_EXPORT_DIRECTORY *exports, const char *name )
+{
+    static const char closed_prefix[] = "__ano__", prefix[] = "__ano_";
+    const size_t closed_len = sizeof(closed_prefix) - 1, prefix_len = sizeof(prefix) - 1;
+    int ordinal = find_name_in_exports_exact( module, exports, name );
+    char new_name[256];
+    size_t len;
+
+    if (ordinal != -1 || strncmp( name, closed_prefix, closed_len )) return ordinal;
+    if ((len = strlen( name + closed_len )) >= sizeof(new_name) - prefix_len) return -1;
+    memcpy( new_name, prefix, prefix_len );
+    memcpy( new_name + prefix_len, name + closed_len, len + 1 );
+    return find_name_in_exports_exact( module, exports, new_name );
+}
