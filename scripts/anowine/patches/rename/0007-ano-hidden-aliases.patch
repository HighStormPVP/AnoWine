index 0000000..6ec12a4
--- /dev/null
+++ b/include/ano/hidden.h
@@ -0,0 +1,67 @@
+/*
+ * Old names a closed part still uses
+ *
+ * Ano (patches/rename/0007): Apple's D3DMetal, which Ano cannot rebuild, still
+ * uses a few of Wine's names (scripts/anowine/aliases.txt). Ano's binaries keep
+ * them out of their readable text: each is stored with every byte XORed with
+ * ANO_HIDDEN_KEY and decoded in memory when it is needed. The key is read
+ * through a volatile, so the compiler cannot fold a decoded name back into the
+ * binary.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __ANO_HIDDEN_H
+#define __ANO_HIDDEN_H
+
+#define ANO_HIDDEN_KEY 0x5a
+#define ANO_HIDE(c) ((char)((c) ^ ANO_HIDDEN_KEY))
+
+/* decodes len bytes of in into out, which holds len + 1 bytes */
+static inline char *ano_unhide( char *out, const char *in, unsigned int len )
+{
+    volatile unsigned char key = ANO_HIDDEN_KEY;
+    unsigned int i;
+
+    for (i = 0; i < len; i++) out[i] = in[i] ^ key;
+    out[len] = 0;
+    return out;
+}
+
+/* the PE mark at 0x40 of a closed part's DLLs, accepted beside Ano's own */
+#define ANO_OLD_MARK_LEN 16
+static inline char *ano_old_mark( char out[ANO_OLD_MARK_LEN + 1] )
+{
+    static const char hidden[ANO_OLD_MARK_LEN] = { ANO_HIDE('W'), ANO_HIDE('i'), ANO_HIDE('n'), ANO_HIDE('e'), ANO_HIDE(' '), ANO_HIDE('b'), ANO_HIDE('u'), ANO_HIDE('i'), ANO_HIDE('l'), ANO_HIDE('t'), ANO_HIDE('i'), ANO_HIDE('n'), ANO_HIDE(' '), ANO_HIDE('D'), ANO_HIDE('L'), ANO_HIDE('L') };
+    return ano_unhide( out, hidden, ANO_OLD_MARK_LEN );
+}
+
+/* the prefix of the old names of ntdll's functions and unix-call tables */
+#define ANO_OLD_PREFIX_LEN 7
+static inline char *ano_old_prefix( char out[ANO_OLD_PREFIX_LEN + 1] )
+{
+    static const char hidden[ANO_OLD_PREFIX_LEN] = { ANO_HIDE('_'), ANO_HIDE('_'), ANO_HIDE('w'), ANO_HIDE('i'), ANO_HIDE('n'), ANO_HIDE('e'), ANO_HIDE('_') };
+    return ano_unhide( out, hidden, ANO_OLD_PREFIX_LEN );
+}
+
+/* the prefix of the old names of D3DMetal's variables */
+#define ANO_OLD_ENV_PREFIX_LEN 4
+static inline char *ano_old_env_prefix( char out[ANO_OLD_ENV_PREFIX_LEN + 1] )
+{
+    static const char hidden[ANO_OLD_ENV_PREFIX_LEN] = { ANO_HIDE('W'), ANO_HIDE('I'), ANO_HIDE('N'), ANO_HIDE('E') };
+    return ano_unhide( out, hidden, ANO_OLD_ENV_PREFIX_LEN );
+}
+
+#endif  /* __ANO_HIDDEN_H */
