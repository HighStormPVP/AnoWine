+/*************************************************************************
+ *		ano_rewrite_old_names
+ *
+ * Ano (patches/rename/0007): a module with the old mark is a closed part
+ * (Apple's D3DMetal, scripts/anowine/aliases.txt). It asks for ntdll's
+ * functions by their old names, through its imports and at run time
+ * (RtlFindExportedRoutineByName, GetProcAddress), and ntdll exports only the
+ * new ones. So each old prefix that starts a name in the module's data becomes
+ * "__ano__", which has the same length, in the module's own memory (its file
+ * is untouched), and find_name_in_exports reads "__ano__x" as "__ano_x". Code
+ * and the module's own export names are left alone.
+ */
+static inline BOOL ano_is_name_char( char c )
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
+}
+
+static void ano_rewrite_old_names( void *module, const IMAGE_NT_HEADERS *nt )
+{
+    static const char new_prefix[] = "__ano__";
+    const IMAGE_DATA_DIRECTORY *exp = &nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT];
+    const IMAGE_SECTION_HEADER *sec = IMAGE_FIRST_SECTION( nt );
+    char *exp_start = (char *)module + exp->VirtualAddress, *exp_end = exp_start + exp->Size;
+    char old_prefix[ANO_OLD_PREFIX_LEN + 1];
+    unsigned int i, count = 0;
+
+    /* sections that share a page with code cannot be made writable alone */
+    if (nt->OptionalHeader.SectionAlignment < page_size) return;
+    ano_old_prefix( old_prefix );
+    for (i = 0; i < nt->FileHeader.NumberOfSections; i++)
+    {
+        char *start = (char *)module + sec[i].VirtualAddress, *end, *p;
+        SIZE_T len = sec[i].Misc.VirtualSize ? sec[i].Misc.VirtualSize : sec[i].SizeOfRawData;
+        BOOL writable = FALSE;
+        ULONG old_prot = 0;
+        void *addr = start;
+        SIZE_T size;
+
+        if (sec[i].Characteristics & (IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_CNT_CODE)) continue;
+        if (sec[i].VirtualAddress >= nt->OptionalHeader.SizeOfImage) continue;
+        len = min( len, nt->OptionalHeader.SizeOfImage - sec[i].VirtualAddress );
+        if (len <= ANO_OLD_PREFIX_LEN) continue;
+        size = len;
+        end = start + len - ANO_OLD_PREFIX_LEN;
+        for (p = start; p < end && (p = memchr( p, '_', end - p )); p++)
+        {
+            if (memcmp( p, old_prefix, ANO_OLD_PREFIX_LEN )) continue;
+            if (p > start && ano_is_name_char( p[-1] )) continue;
+            if (!ano_is_name_char( p[ANO_OLD_PREFIX_LEN] )) continue;
+            if (p >= exp_start && p < exp_end) continue;
+            if (!writable)
+            {
+                if (NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size, PAGE_READWRITE, &old_prot )) break;
+                writable = TRUE;
+            }
+            memcpy( p, new_prefix, ANO_OLD_PREFIX_LEN );
+            count++;
+        }
+        if (writable) NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size, old_prot, &old_prot );
+    }
+    TRACE( "%p: %u old names now read as Ano's\n", module, count );
+}
