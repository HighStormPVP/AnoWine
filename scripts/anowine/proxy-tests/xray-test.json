{
  "log": {
    "loglevel": "info",
    "access": "__ACCESS_LOG__"
  },
  "dns": {
    "hosts": {
      "anotest.example.com": "127.0.0.1"
    }
  },
  "inbounds": [
    {
      "tag": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": { "auth": "noauth", "udp": false }
    }
  ],
  "outbounds": [
    { "tag": "direct", "protocol": "freedom", "settings": { "domainStrategy": "UseIP" } },
    { "tag": "to-echo", "protocol": "freedom", "settings": { "redirect": "127.0.0.1:7000" } },
    { "tag": "block", "protocol": "blackhole" }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      { "type": "field", "ip": ["192.0.2.1/32"], "outboundTag": "to-echo" },
      { "type": "field", "domain": ["full:anotest.example.com"], "outboundTag": "direct" },
      { "type": "field", "network": "tcp,udp", "outboundTag": "block" }
    ]
  }
}
